{
    "name": "cheeck-backbround-cover",
    "displayName": "Cheeck Backbround Cover",
    "description": "好きな画像や動画を Devin / VS Code: の背景全体に敷き詰める拡張機能（ホットリロード対応）。",
    "version": "3.6.5",
    "publisher": "AkiraCheeckbox",
    "engines": {
        "vscode": "^1.38.0"
    },
    "one_title": true,
    "icon": "resources/background-cover.png",
    "galleryBanner": {
        "color": "#03385a",
        "theme": "dark"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "Background",
        "Theme",
        "Devin"
    ],
    "activationEvents": [
        "*"
    ],
    "license": "ISC",
    "main": "./out/extension",
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "contributes": {
        "commands": [
            {
                "command": "extension.backgroundCover.start",
                "title": "backgroundCover - 開始"
            },
            {
                "command": "extension.backgroundCover.refresh",
                "title": "backgroundCover - 更新"
            },
            {
                "command": "extension.backgroundCover.nest",
                "title": "backgroundCover - パーティクル"
            },
            {
                "command": "extension.backgroundCover.nextRandom",
                "title": "backgroundCover - 次のランダム背景"
            },
            {
                "command": "extension.backgroundCover.exportSettings",
                "title": "backgroundCover - 設定をエクスポート"
            },
            {
                "command": "extension.backgroundCover.importSettings",
                "title": "backgroundCover - 設定をインポート"
            },
            {
                "command": "extension.backgroundCover.savePreset",
                "title": "backgroundCover - プリセットを保存"
            },
            {
                "command": "extension.backgroundCover.loadPreset",
                "title": "backgroundCover - プリセットを適用"
            },
            {
                "command": "extension.backgroundCover.deletePreset",
                "title": "backgroundCover - プリセットを削除"
            },
            {
                "command": "extension.backgroundCover.randomOnlineImage",
                "title": "backgroundCover - オンライン画像をランダム取得"
            },
            {
                "command": "extension.backgroundCover.tagCurrentImage",
                "title": "backgroundCover - 背景にタグを付ける"
            },
            {
                "command": "extension.backgroundCover.searchImagesByTag",
                "title": "backgroundCover - タグで画像を検索"
            },
            {
                "command": "backgroundCover.refreshEntry",
                "title": "更新",
                "icon": {
                    "light": "resources/light/refresh.svg",
                    "dark": "resources/dark/refresh.svg"
                }
            },
            {
                "command": "backgroundCover.home",
                "title": "ホーム",
                "icon": {
                    "light": "resources/light/home.svg",
                    "dark": "resources/dark/home.svg"
                }
            },
            {
                "command": "backgroundCover.switchMode",
                "title": "設定",
                "icon": "$(settings-gear)"
            },
            {
                "command": "backgroundCover.support",
                "title": "作者を支援",
                "icon": "$(heart)"
            }
        ],
        "keybindings": [
            {
                "command": "extension.backgroundCover.refresh",
                "key": "ctrl+shift+f7"
            },
            {
                "command": "extension.backgroundCover.nextRandom",
                "key": "ctrl+shift+f8"
            }
        ],
        "configuration": {
            "title": "background-cover 設定",
            "properties": {
                "backgroundCover.opacity": {
                    "type": "number",
                    "maximum": 0.8,
                    "minimum": 0,
                    "default": 0.2,
                    "description": "背景の透明度（0 - 0.8）"
                },
                "backgroundCover.blur": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 0,
                    "default": 0,
                    "description": "背景のぼかし（0 - 100）"
                },
                "backgroundCover.imagePath": {
                    "type": "string",
                    "default": "",
                    "description": "背景画像のパス"
                },
                "backgroundCover.perWindowBackground": {
                    "type": "boolean",
                    "default": true,
                    "description": "各ウィンドウで独自の背景画像を保持します。オフにすると全ウィンドウで同じ背景を共有します（従来の動作）。"
                },
                "backgroundCover.randomImageFolder": {
                    "type": "string",
                    "default": "",
                    "description": "ランダム背景用の画像フォルダのパス"
                },
                "backgroundCover.autoStatus": {
                    "type": "boolean",
                    "default": false,
                    "description": "起動時に自動でランダムに背景を変更します"
                },
                "backgroundCover.autoInterval": {
                    "type": "number",
                    "default": 10,
                    "description": "背景を自動変更する間隔（秒）"
                },
                "backgroundCover.sizeModel": {
                    "type": "string",
                    "enum": [
                        "cover",
                        "repeat",
                        "contain",
                        "center",
                        "not_center",
                        "not_right_bottom",
                        "not_right_top",
                        "not_left",
                        "not_right",
                        "not_top",
                        "not_bottom"
                    ],
                    "default": "cover",
                    "description": "背景画像のサイズ調整モード"
                },
                "backgroundCover.blendModel": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "multiply",
                        "lighten"
                    ],
                    "default": "cover",
                    "description": "背景画像のブレンドモード"
                },
                "backgroundCover.lightImagePath": {
                    "type": "string",
                    "default": "",
                    "description": "ライトテーマ時の背景画像パス"
                },
                "backgroundCover.darkImagePath": {
                    "type": "string",
                    "default": "",
                    "description": "ダークテーマ時の背景画像パス"
                },
                "backgroundCover.highContrastImagePath": {
                    "type": "string",
                    "default": "",
                    "description": "ハイコントラストテーマ時の背景画像パス"
                },
                "backgroundCover.defaultOnlinePage": {
                    "type": "string",
                    "default": "https://vs.20988.xyz/d/24-vscodebei-jing-tu-tu-ku",
                    "description": "オンライン画像ギャラリーのデフォルトページ"
                },
                "backgroundCover.unsplashAccessKey": {
                    "type": "string",
                    "default": "",
                    "description": "Unsplash API Access Key（空欄の場合は Picsum を使用）"
                },
                "backgroundCover.pexelsApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "Pexels API Key（unsplashAccessKey が空の場合に使用）"
                },
                "backgroundCover.onlineImageQuery": {
                    "type": "string",
                    "default": "",
                    "description": "Unsplash / Pexels 検索キーワード"
                },
                "backgroundCover.onlineImageWidth": {
                    "type": "number",
                    "default": 1920,
                    "description": "Picsum 使用時の画像幅"
                },
                "backgroundCover.onlineImageHeight": {
                    "type": "number",
                    "default": 1080,
                    "description": "Picsum 使用時の画像高さ"
                },
                "backgroundCover.videoVolume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0,
                    "description": "動画背景の音量（0 = ミュート）"
                },
                "backgroundCover.videoPlaybackRate": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 5,
                    "default": 1,
                    "description": "動画背景の再生速度"
                },
                "backgroundCover.showClock": {
                    "type": "boolean",
                    "default": false,
                    "description": "背景の上に時計を表示します"
                },
                "backgroundCover.clockPosition": {
                    "type": "string",
                    "enum": ["top-right", "top-left", "bottom-right", "bottom-left"],
                    "default": "top-right",
                    "description": "時計の表示位置"
                },
                "backgroundCover.clockColor": {
                    "type": "string",
                    "default": "rgba(255,255,255,0.7)",
                    "description": "時計の文字色"
                },
                "backgroundCover.clockSize": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 120,
                    "default": 24,
                    "description": "時計のフォントサイズ (px)"
                },
                "backgroundCover.agentImagePath": {
                    "type": "string",
                    "default": "",
                    "description": "Devin Agent ウィンドウ用の背景画像パス"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "backgroundCover-explorer",
                    "title": "backgroundCover",
                    "icon": "resources/big.svg"
                }
            ]
        },
        "views": {
            "backgroundCover-explorer": [
                {
                    "id": "backgroundCover.studio",
                    "type": "webview",
                    "name": "スタジオ",
                    "when": "backgroundCover.mode == 'menu'"
                },
                {
                    "id": "backgroundCover.menu",
                    "name": "メニュー",
                    "when": "backgroundCover.mode == 'legacyMenu'"
                },
                {
                    "id": "backgroundCover.readerView",
                    "type": "webview",
                    "name": "オンラインギャラリー",
                    "when": "backgroundCover.mode != 'menu' && backgroundCover.mode != 'legacyMenu'"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "backgroundCover.refreshEntry",
                    "when": "view == backgroundCover.studio",
                    "group": "navigation@0"
                },
                {
                    "command": "backgroundCover.support",
                    "when": "view == backgroundCover.studio",
                    "group": "navigation@1"
                }
            ]
        }
    },
    "bugs": {
        "url": "https://github.com/AkiraCheeckbox/cheeck-backbround-cover/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/AkiraCheeckbox/cheeck-backbround-cover.git"
    },
    "homepage": "https://github.com/AkiraCheeckbox/cheeck-backbround-cover/blob/master/README.md",
    "scripts": {
        "vscode:prepublish": "npm run build:webview && npm run compile",
        "vscode:uninstall": "node ./out/uninstall",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package",
        "build:webview": "cd webview && npm install --silent && npm run build",
        "watch:webview": "cd webview && npm run dev",
        "test": "npm run compile && node ./node_modules/vscode/bin/test",
        "check": "tslint -p ./"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/lockfile": "^1.0.4",
        "@types/mocha": "^5.2.7",
        "@types/node": "^22.9.0",
        "@types/proper-lockfile": "^4.1.4",
        "@types/vscode": "^1.30.0",
        "@vscode/vsce": "^3.9.2",
        "@vscode/test-electron": "^2.3.2",
        "typescript": "^4.5.4"
    },
    "dependencies": {
        "async-mutex": "^0.5.0",
        "fs-extra": "^11.2.0",
        "proper-lockfile": "^4.1.2",
        "@vscode/sudo-prompt": "^9.3.2"
    }
}
